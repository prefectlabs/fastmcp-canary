{
  "name": "fastmcp-canary-on-published-release",
  "description": "Discover published FastMCP releases and enqueue one downstream canary per release",
  "enabled": true,
  "trigger": {
    "type": "event",
    "posture": "Reactive",
    "threshold": 1,
    "within": 0,
    "expect": ["fastmcp.canary.github.release.published"],
    "match": {"prefect.resource.id": "github.PrefectHQ/fastmcp.release.*"},
    "match_related": {},
    "after": [],
    "for_each": ["prefect.resource.id"]
  },
  "actions": [{
    "type": "run-deployment",
    "source": "selected",
    "deployment_id": "00a25d0e-0e97-4ebb-abe1-17b500b3003c",
    "parameters": {
      "release_id": {
        "__prefect_kind": "json",
        "value": {
          "__prefect_kind": "jinja",
          "template": "{{ event.resource['github.release.id'] | int }}"
        }
      }
    }
  }],
  "actions_on_trigger": [],
  "actions_on_resolve": []
}
